    "Title": {
      "@value": "Decision tree survival prediction model for serous ovarian carcinoma based on preoperative circulating leukocytes [web:1]"
    },
    "Description": {
      "@value": "Supervised machine learning decision tree model predicting overall and progression-free survival in serous ovarian carcinoma using preoperative leukocyte counts, leukocyte differentials, CA-125, clinicopathological factors, and demographic characteristics. [web:1]"
    },
    "Editor Note": {
      "@value": "Ontology URIs and labels should be independently validated by the user; some codes are provisional where explicit NCIT terms were not directly confirmable. [web:1]"
    },
    "Created by": {
      "@value": "https://maastro.nl/department/radiation-oncology/cds-group"
    },
    "Creation date": {
      "@value": "2026-02-25",
      "@type": "xsd:date"
    },
    "Contact email": {
      "@value": "alberto.traverso@maastro.nl"
    },
    "List of authors": {
      "@value": "Ying Feng; Zhixiang Wang; Ran Cui; Meizhu Xiao; Huiqiao Gao; Huimin Bai; Bert Delvoux; Zhen Zhang; Andre Dekker; Andrea Romano; Shuzhen Wang; Alberto Traverso; Chongdong Liu; Zhenyu Zhang [web:1]"
    },
    "Developed at CDS (Maastro)": [
      {
        "@value": "Yes [web:1]"
      }
    ],
    "References to papers": [
      {
        "@value": "Feng Y, Wang Z, Cui R, et al. Clinical analysis and artificial intelligence survival prediction of serous ovarian cancer based on preoperative circulating leukocytes. Journal of Ovarian Research. 2022;15:64. doi:10.1186/s13048-022-00994-2. [web:1]"
      }
    ],
    "References to code": [
      {
        "@value": "Not publicly released; decision tree implemented in Python 3.8 using scikit-learn 0.24 as described in the publication. [web:1]"
      }
    ],
    "Target organ": {
      "@id": "http://purl.obolibrary.org/obo/UBERON_0000995",
      "rdfs:label": "ovary"
    },
