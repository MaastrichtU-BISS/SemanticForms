  "Outcome": {
    "@id": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C48288",
    "rdfs:label": "Overall Survival"
  },
  "Outcome label": {
    "@value": "Overall survival (OS) at follow-up after primary cytoreductive surgery for serous ovarian carcinoma. [web:1]"
  },
  "Outcome type": {
    "@value": "P"
  },
  "Applicability criteria": [
    {
      "@value": "Adult patients with histologically confirmed serous ovarian carcinoma (serous cystadenocarcinoma or high-grade serous cystadenocarcinoma) treated with primary cytoreductive surgery at Beijing Chaoyang Hospital (2009–2018) and standard platinum-based chemotherapy, with complete preoperative routine blood tests within 90 days and clinical data available. [web:1]"
    }
  ],
  "Foundational model or algorithm used": {
    "@id": "https://scikit-learn.org/stable/modules/tree.html",
    "rdfs:label": "Decision Tree Classifier (CART)"
  },
  "Primary intended use(s)": [
    {
      "@value": "Preoperative prognostic stratification of serous ovarian carcinoma patients based on routine blood tests and clinicopathologic factors to estimate survival probability. [web:1]"
    }
  ],
  "Primary intended users": [
    {
      "@value": "Gynecologic oncologists, radiation oncologists, clinical researchers, and multidisciplinary tumor boards. [web:1]"
    }
  ],
  "Out-of-scope use cases": [
    {
      "@value": "Prediction in non-serous ovarian cancers, other primary tumor sites, patients without standard platinum-based chemotherapy, or use for treatment selection without clinical oversight. [web:1]"
    }
  ],
  "Data": [
    {
      "@value": "Retrospective single-center cohort of 98 patients with serous ovarian carcinoma and 75 uterine prolapse controls; 93 patients with homogeneous first-line platinum-based chemotherapy regimen used for decision tree training. [web:1]"
    }
  ],
  "Human life": [
    {
      "@value": "Model outputs can influence risk stratification discussions but must not be used as the sole basis for life-critical decisions; human clinical judgment remains essential. [web:1]"
    }
  ],
  "Mitigations": [
    {
      "@value": "Use only as a decision-support tool alongside established prognostic factors and guidelines; validate locally before deployment; regularly monitor calibration and discrimination; restrict to populations similar to the development cohort; clearly communicate uncertainty and AUC=0.69 performance to users. [web:1]"
    }
  ],
  "Risks and harms": [
    {
      "@value": "Potential misclassification of high- or low-risk patients due to modest AUC (0.69), small sample size, and single-center data, which could lead to over- or under-treatment if used without caution. [web:1]"
    }
  ],
  "Use cases": {
    "@value": "Research-oriented prognostic modeling, hypothesis generation about leukocyte-based biomarkers, and exploratory risk stratification in serous ovarian carcinoma prior to larger external validation. [web:1]"
  },
  "Additional concerns": {
    "@value": "Leukocyte profiles may change significantly after surgery and chemotherapy, limiting the model to preoperative use; lack of external validation; absence of detailed handling of missing data and potential confounders. [web:1]"
  },
  "Previous model tests1": [
    {
      "@context": {
        "Performance metric": "https://schema.metadatacenter.org/properties/f95c7b9f-a5bc-410b-ad38-d719a3044fe4",
        "Link to dataset": "https://schema.metadatacenter.org/properties/d750fe0d-6813-4536-a918-bd9218f472bf",
        "Link to reference paper": "https://schema.metadatacenter.org/properties/d59a2224-fbe8-4380-b66b-a2cc05c6b3ae",
        "Notes": "https://schema.metadatacenter.org/properties/c6428800-ffc3-41b6-986a-3a95ae936c6e"
      },
      "Performance metric": [
        {
          "@context": {
            "Metric Label": "https://schema.metadatacenter.org/properties/f247f273-151f-4c1d-bd69-8ed6a728ed33",
            "Measured metric (mean value)": "https://schema.metadatacenter.org/properties/e6a0cec6-e37d-431c-8480-e3eba2f0d071",
            "Acceptance level": "https://schema.metadatacenter.org/properties/668d9bbc-ae81-4af0-a11e-7a401c409f98",
            "Additional information (if needed)": "https://schema.metadatacenter.org/properties/cbcf4b91-fcb5-4462-8eae-77cba960c0e0",
            "Measured metric (lower bound of the 95% confidence interval)": "https://schema.metadatacenter.org/properties/d93c93b8-f1ce-4d2b-b78d-1b0f2d0c1ef2",
